# SQLite path is resolved relative to prisma/schema.prisma -> apps/api/prisma/dev.db
DATABASE_URL="file:./dev.db"
PORT=4000

# ── Rig-side report entry (/entry/*) ────────────────────────────────────────
# Signing key for the login tokens. Leave it blank and the server invents a
# random one per process, so every restart logs everyone out. run.sh / run.bat
# generate a real one into apps/api/.env on first run; set it by hand elsewhere:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENTRY_TOKEN_SECRET=
# Login lifetime in seconds (default 7 days).
ENTRY_TOKEN_TTL=604800
# First-run admin account, created only when the user table is empty.
# Without ENTRY_ADMIN_PASSWORD the password is "admin" and must be changed at
# first login.
ENTRY_ADMIN_USER=admin
#ENTRY_ADMIN_PASSWORD=

# The converted WellView databases (/wellview) are admin-only by default: they
# hold every well in the asset and there is no mapping from a WellView idwell
# GUID to this application's own well assignments, so a company man cannot be
# scoped to their wells there. Set this to true to let any signed-in user in —
# a deliberate choice, not the default.
WELLVIEW_DB_ALLOW_NON_ADMIN=false
