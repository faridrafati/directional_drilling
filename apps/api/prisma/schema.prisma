// Prisma schema — directional drilling project store.
// SQLite for single-file projects equivalent to the old Access .mdb.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Project {
  id        String    @id @default(cuid())
  name      String
  // UnitSystem stored as JSON-encoded string (SQLite has no JSON type).
  units     String // JSON: { length, angle, dls }
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  countries Country[]
}

model Country {
  id        String  @id @default(cuid())
  projectId String
  name      String
  area      String?
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  fields    Field[]

  @@index([projectId])
}

model Field {
  id        String     @id @default(cuid())
  countryId String
  name      String
  ns        Float?
  ew        Float?
  msl       Float?
  country   Country    @relation(fields: [countryId], references: [id], onDelete: Cascade)
  wells     Well[]
  grids     GridFile[]

  @@index([countryId])
}

model Well {
  id           String        @id @default(cuid())
  fieldId      String
  name         String
  ns           Float?
  ew           Float?
  msl          Float?
  wellType     String?
  tvd          Float?
  md           Float?
  comment      String?
  field        Field         @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  calculations Calculation[]

  @@index([fieldId])
}

model Calculation {
  id        String     @id @default(cuid())
  wellId    String
  name      String
  type      String // "WellDesign" | "SurveyEditor" (SQLite has no enum)
  well      Well       @relation(fields: [wellId], references: [id], onDelete: Cascade)
  segments  Segment[]
  stations  Station[]
  keypoints Keypoint[]

  @@index([wellId])
}

// Exact milestone values produced by the dispatcher (KOP / EOC / Target / ...).
// One Keypoint per role row of each profile group. These come from the
// builder's analytic equations, NOT by sampling the densified path.
model Keypoint {
  id            String      @id @default(cuid())
  calculationId String
  // segmentOrder of the LAST row in the group (the dispatcher's target).
  segmentOrder  Int
  // 0..N-1 position within the group; row k of the group reads keypoint k.
  roleIndex     Int
  comment       String?
  md            Float
  inc           Float
  azm           Float
  tvd           Float
  vsec          Float
  ns            Float
  ew            Float
  dls           Float
  tf            Float
  br            Float
  tr            Float
  dmd           Float
  calculation   Calculation @relation(fields: [calculationId], references: [id], onDelete: Cascade)

  @@index([calculationId, segmentOrder, roleIndex])
}

model Segment {
  id            String      @id @default(cuid())
  calculationId String
  order         Int
  profileType   Int
  // Pascal-style milestone role: KOP / EOC / Target / etc. Null for START.
  // Each profile spawns N rows (one per role); see profileRoles in the web app.
  milestoneRole String?
  comment       String?
  md            Float
  inc           Float
  azm           Float
  tvd           Float
  vsec          Float
  ns            Float
  ew            Float
  dls           Float
  tf            Float
  br            Float
  tr            Float
  dmd           Float
  surveyTools   String?
  calculation   Calculation @relation(fields: [calculationId], references: [id], onDelete: Cascade)

  @@index([calculationId, order])
}

model Station {
  id            String      @id @default(cuid())
  calculationId String
  // Position in the densified trajectory (0..N-1, sortable).
  order         Int
  // The Segment.order this station belongs to (the dispatcher target row).
  segmentOrder  Int         @default(0)
  comment       String?
  md            Float
  inc           Float
  azm           Float
  tvd           Float
  vsec          Float
  ns            Float
  ew            Float
  dls           Float
  tf            Float
  br            Float
  tr            Float
  dmd           Float
  calculation   Calculation @relation(fields: [calculationId], references: [id], onDelete: Cascade)

  @@index([calculationId, order])
  @@index([calculationId, segmentOrder])
}

model GridFile {
  id       String @id @default(cuid())
  fieldId  String
  name     String
  filename String
  xmin     Float
  xmax     Float
  ymin     Float
  ymax     Float
  xinc     Float
  yinc     Float
  ncol     Int
  nrow     Int
  units    String
  errorVal Float
  data     Bytes
  field    Field  @relation(fields: [fieldId], references: [id], onDelete: Cascade)

  @@index([fieldId])
}

// ═══════════════════════════════════════════════════════════════════════════
//  Rig-side daily report ENTRY (company man data capture)
//
//  The /ddr/* routes read the legacy Access→SQLite databases read-only; those
//  are historical. This block is the writable side: company men on the rig log
//  in and fill the same DR.xls form for the well they are assigned to, and the
//  rows land here (apps/api/prisma/dev.db), never in the legacy files.
//
//  Model names are prefixed Entry* so they can't collide with the directional
//  project store above (Project / Well / Calculation ...).
// ═══════════════════════════════════════════════════════════════════════════

model EntryUser {
  id                 String            @id @default(cuid())
  username           String            @unique
  fullName           String
  // "admin" (manages rigs / wells / users) | "companyman" (files reports).
  role               String            @default("companyman")
  // scrypt, stored as "salt:derivedKey" hex — see entry/auth.ts.
  passwordHash       String
  mustChangePassword Boolean           @default(false)
  active             Boolean           @default(true)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  assignments        EntryAssignment[]
  reports            EntryReport[]
}

model EntryRig {
  id         String         @id @default(cuid())
  name       String         @unique
  contractor String?
  createdAt  DateTime       @default(now())
  wells      EntryWell[]
  mudPumps   EntryMudPump[]
}

/// A well being drilled now — the DR.xls header band is well-level, so it lives
/// here and is filled once instead of on every daily report.
model EntryWell {
  id                     String                 @id @default(cuid())
  rigId                  String
  name                   String
  field                  String?
  /// Optional link to the legacy A01 WellCode, so an entered well can later be
  /// lined up with its historical reports.
  legacyWellCode         String?
  location               String?
  wellType               String?
  profile                String?
  reservoir              String?
  contractor             String?
  spudDate               String?
  rigReleasedDate        String?
  /// a.json report_header: original_kb_elevation_m. RT and KB are the same datum
  /// on these rigs; the label reads "R.T. / KB elevation" in the UI.
  rtElevation            Float?
  waterDepth             Float?
  finalForecastDepth     Float?
  forecastDays           Float?
  // ── a.json report_header — well-level identification (typed once) ──
  /// client — the operator the report is filed for, e.g. POGC.
  client                 String?
  /// latitude / longitude as PRINTED (DMS text, e.g. 26° 46' 39.11" N).
  /// Kept as text on purpose: the source is a formatted string and round-tripping
  /// it through a decimal would lose the exact printed form the report must show.
  latitude               String?
  longitude              String?
  /// other_elevation_note — free text, usually "Air Gap(m): 18".
  elevationNote          String?
  /// comment — free text; on jack-ups the leg penetration
  /// ("Leg Pen.(m): FWD: 1.92/STBD: 1.86/PORT: 1.68").
  comment                String?
  // ── WellView well-header block (reports 01, 03, 04, 05, 06, 07, 22, 30 …) ──
  /// API / UWI as printed, e.g. "100/02-02-050-20W5/00". NOT legacyWellCode,
  /// which is the archive's A01 link — a different identifier entirely.
  apiUwi                 String?
  /// "License #" on the well-header block.
  licenseNo              String?
  /// "State/Province". `location` stays the block/area free text it already is.
  stateProvince          String?
  /// Ground elevation, metres (the samples print ft — we print our own unit).
  groundElevation        Float?
  /// Casing-flange elevation, metres.
  casingFlangeElevation  Float?
  /// KB–Ground distance, metres. STORED, never derived from rtElevation −
  /// groundElevation: the sample prints the casing-flange distance while BOTH
  /// ground figures are blank, which proves the four are independent entries.
  kbGroundDistance       Float?
  /// KB–Casing flange distance, metres.
  kbCasingFlangeDistance Float?
  active                 Boolean                @default(true)
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt
  rig                    EntryRig               @relation(fields: [rigId], references: [id], onDelete: Cascade)
  assignments            EntryAssignment[]
  reports                EntryReport[]
  jobs                   Job[]
  wellbores              EntryWellbore[]
  bhaRuns                EntryBhaRun[]
  holeSections           HoleSection[]
  casingStrings          CasingString[]
  lessons                EntryIntervalLesson[]
  kicks                  EntryKick[]
  lostCirculation        EntryLostCirculation[]

  @@unique([rigId, name])
  @@index([rigId])
}

/// Which wells a company man may file reports for.
model EntryAssignment {
  id        String    @id @default(cuid())
  userId    String
  wellId    String
  createdAt DateTime  @default(now())
  user      EntryUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  well      EntryWell @relation(fields: [wellId], references: [id], onDelete: Cascade)

  @@unique([userId, wellId])
  @@index([wellId])
}

/// One daily drilling report — the L04-equivalent header plus every section of
/// the DR.xls sheet as child rows.
model EntryReport {
  id         String  @id @default(cuid())
  wellId     String
  /// Author (the company man who filed it).
  userId     String
  /// Day number within the well, like the legacy SerialNo.
  serialNo   Int
  /// Jalali (Shamsi) "YYYY/MM/DD", the same shape the legacy DBs store.
  reportDate String
  /// "draft" — still editable by its author | "submitted" — locked.
  status     String  @default("draft")
  /// The job this day belongs to (WellView reports are job-centric, this store
  /// is day-centric — this is the bridge). Nullable and SetNull: deleting a job
  /// must never delete the crew's daily reports, and a well with no job at all
  /// still files reports exactly as it does today.
  jobId      String?
  /// Optional day → phase attribution, stamped by an admin action rather than
  /// derived on read (phase boundaries are datetimes, days are dates).
  phaseId    String?

  // ── Well / Operations ──
  morningDepth    Float?
  midnightDepth   Float?
  previousDepth   Float?
  /// a.json end_depth_tvd_mkb — the day's end depth on the TVD scale.
  endDepthTvd     Float?
  drillingTime    Float?
  /// Cumulative DRILLING hours (DR.xls). Not the same quantity as
  /// cumTimeLogDays below — that is elapsed days on the well.
  cumDrillingTime Float?
  // ── a.json report_header — per-day operational counters ──
  /// cum_time_log_days — cumulative elapsed days on the well, e.g. 3.13.
  cumTimeLogDays  Float?
  /// days_lti — days since the last lost-time incident, e.g. 132.
  daysLti         Float?
  /// head_count — persons on board.
  headCount       Float?
  /// hazards — free text, e.g. "STOP CARD: 12".
  hazards         String?
  holeSize        String?
  formation       String?
  lithology       String?
  lastCasing      String?
  linerLap        String?
  kop             String?
  wellSiteSupt    String?
  opnSupt         String?
  progEng         String?
  geologist       String?
  toolPusher1     String?
  toolPusher2     String?

  // ── Mud volume balance (legacy N05) ──
  formationLoss Float?
  mudLossUnit   Float?
  mudGains      Float?

  // ── Summary / weather ──
  /// a.json operations.summary — the day's narrative.
  description     String?
  /// a.json operations.at_report_time — where the rig is RIGHT NOW, e.g.
  /// "RIH 24" H.S. BHA at 21m." a.json marks the `operations` block required.
  opsAtReportTime String?
  /// a.json operations.next_report_period — what is planned next.
  opsNextPeriod   String?
  windSpeedDir    String?
  waveVisible     String?
  freshWater      Float?
  fuel            Float?
  // ── reports 06 / 07 header cells ──
  /// Weather, road and hole condition — free text, as the sheet prints them.
  weather         String?
  roadCondition   String?
  holeCondition   String?
  /// Air temperature in °C (the samples print °F; we print our own unit).
  temperatureC    Float?
  /// Start depth on the TVD scale. `endDepthTvd` above is its other half —
  /// report 07 prints both, report 06 neither.
  startDepthTvd   Float?
  /// Report 07's free-text "Remarks", distinct from `description` (the 24-hour
  /// summary) and from `opsAtReportTime`.
  remarks         String?
  /// Days since the last recordable incident. `daysLti` above is lost-time.
  daysRi          Float?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  submittedAt DateTime?

  well               EntryWell                @relation(fields: [wellId], references: [id], onDelete: Cascade)
  user               EntryUser                @relation(fields: [userId], references: [id])
  job                Job?                     @relation(fields: [jobId], references: [id], onDelete: SetNull)
  phase              JobPhase?                @relation(fields: [phaseId], references: [id], onDelete: SetNull)
  bitRuns            EntryBitRun[]
  drillStrings       EntryDrillString[]
  drillString        EntryDrillPipe[]
  tools              EntryTool[]
  mud                EntryMud?
  solidControl       EntrySolidControl[]
  chemicals          EntryChemical[]
  casing             EntryCasingRun[]
  formationTops      EntryFormationTop[]
  supervisors        EntrySupervisor[]
  companies          EntryOnboardCompany[]
  hseDrills          EntryHseDrill[]
  bulkMaterials      EntryBulkMaterial[]
  wellheads          EntryWellheadComponent[]
  scrRates           EntryScrRate[]
  supportVessels     EntrySupportVessel[]
  fit                EntryFit?
  marine             EntryMarine?
  surveys            EntrySurvey[]
  drillingParameters EntryDrillingParameter[]
  timeBreakdown      EntryTimeEntry[]
  operations         EntryOperation[]
  mudVolumes         EntryMudVolume[]
  safetyChecks       EntrySafetyCheck[]
  safetyIncidents    EntrySafetyIncident[]
  intervalProblems   EntryIntervalProblem[]

  @@unique([wellId, reportDate])
  @@unique([wellId, serialNo])
  @@index([wellId, status])
  @@index([userId])
  @@index([jobId, serialNo])
  @@index([phaseId])
}

model EntryBitRun {
  id              String       @id @default(cuid())
  reportId        String
  order           Int          @default(0)
  bitNo           String?
  bitSerialNo     String?
  size            String?
  type            String?
  iadcCode        String?
  nozzles         String?
  tfa             Float?
  // ── a.json drill_strings[].bit additions ──
  make            String? /// make, e.g. CST
  model           String? /// model
  bitRevs         Float? /// bit_revs
  meterage        Float?
  hours           Float?
  wob             Float?
  rpm             Float?
  torque          String?
  dullGrade       String?
  reasonPulled    String?
  pumpType        String?
  pumpOutput      Float?
  pumpPressure    Float?
  annularVelocity Float?
  hsi             Float?
  /// Report 06's "Length (ft)" on the drill-string block — the bit's length.
  lengthM         Float?
  /// Report 02's "Item Cost (Cost)" on the bit sub-table.
  itemCost        Float?
  /// The multi-day run this day's bit row belongs to (reports 02 and 03).
  bhaRunId        String?
  cmtDrilled      String?
  washAndRun      String?
  bitChangeIn     String?
  bitChangeOut    String?
  report          EntryReport  @relation(fields: [reportId], references: [id], onDelete: Cascade)
  bhaRun          EntryBhaRun? @relation(fields: [bhaRunId], references: [id], onDelete: SetNull)

  @@index([reportId, order])
}

/// D/P size + grade columns under the BHA (Unit10.pas rows 34–36).
model EntryDrillPipe {
  id       String      @id @default(cuid())
  reportId String
  order    Int         @default(0)
  size     String?
  grade    String?
  lengthM  Float?
  report   EntryReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([reportId, order])
}

/// Jar / MWD / DH-motor row of the "Drilling tools" table.
model EntryTool {
  id       String      @id @default(cuid())
  reportId String
  /// "jar" | "mwd" | "dhMotor"
  kind     String
  type     String?
  size     String?
  serialNo String?
  hours    Float?
  report   EntryReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@unique([reportId, kind])
}

/// Mud properties (legacy N01) — one reported check per day.
/// Mud check for the day.
///
/// A UNION of two report standards, deliberately: the DR.xls fields the office
/// archive already uses (fan600/300, PF/MF, e-stability, air/foam, O:W …) plus
/// a.json's `mud_information` block. Dropping the DR.xls-only fields to match
/// a.json exactly would lose data the legacy form captures, so both live here and
/// the subform groups them.
model EntryMud {
  id                  String      @id @default(cuid())
  reportId            String      @unique
  mudSystem           String? /// a.json: type
  /// Mud weight RANGE in ppg. a.json carries a single density_ppg, DR.xls a
  /// min/max pair — 91% of the 62k archive checks record the range, which one
  /// value cannot express, so the range wins and is stated in a.json's unit.
  /// A PEDC report giving a single density fills both ends.
  densityMinPpg       Float?
  densityMaxPpg       Float?
  reportTime          String?
  funnelVisc          Float? /// a.json: funnel_viscosity_s_qt
  // ── a.json mud_information additions ──
  depthMkb            Float? /// depth_mkb — depth the sample was taken at
  tFlowlineC          Float? /// t_flowline_c
  filtrateMl          Float? /// filtrate_ml_30min
  vis3rpm             Float? /// vis_3rpm
  vis6rpm             Float? /// vis_6rpm
  percentWater        Float? /// percent_water
  lowGravitySolidsPct Float? /// low_gravity_solids_pct
  hardnessCaPpm       Float? /// hardness_ca_ppm
  mudLostBbl          Float? /// mud_lost_to_hole_bbl
  activeMudVolBbl     Float? /// active_mud_volume_bbl
  volMudResBbl        Float? /// vol_mud_res_bbl
  pv                  Float?
  yp                  Float?
  gelInitial          Float?
  gel10min            Float?
  fan600              Float?
  fan300              Float?
  ph                  Float?
  alkalinity          Float?
  hpht                Float?
  airFoam             Float?
  oilPct              Float?
  oilWaterRatio       String?
  eStability          Float?
  kcl                 Float?
  mbt                 Float?
  pf                  Float?
  mf                  Float?
  chloride            Float?
  solidsPct           Float?
  // ── reports 06 / 07 mud-check cells ──
  filterCake32nds     Float? /// Filter Cake (1/32")
  sandPct             Float? /// Sand (%)
  gel30min            Float? /// Gel 30 min
  pm                  Float? /// Pm (mL/mL) — `pf` is above
  potassiumMgL        Float? /// Potassium (mg/L)
  wholeMudAddedBbl    Float? /// Whole Mud Added (bbl)
  mudLostSurfBbl      Float? /// Mud Lost to Surface (bbl) — `mudLostBbl` is to hole
  report              EntryReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
}

/// Clay Jactor / Mud Cleaner / Shaker — HRS, U.F., O.F., FEED, CONS, F.PRS.
model EntrySolidControl {
  id        String      @id @default(cuid())
  reportId  String
  unit      String
  hours     Float?
  underFlow Float?
  overFlow  Float?
  feed      Float?
  cons      Float?
  fprs      Float?
  report    EntryReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@unique([reportId, unit])
}

model EntryChemical {
  id          String      @id @default(cuid())
  reportId    String
  order       Int         @default(0)
  material    String?
  unit        String?
  used        Float?
  received    Float?
  stock       Float?
  outstanding Float?
  requested   Float?
  sent        Float?
  report      EntryReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([reportId, order])
}

/// Casing / liner run — a.json `casing_string` unioned with the DR.xls columns.
model EntryCasingRun {
  id             String        @id @default(cuid())
  reportId       String
  order          Int           @default(0)
  casing         String? /// csg_des
  /// set_depth_mkb — the shoe depth.
  depth          Float?
  joints         Float?
  // ── a.json casing_string additions ──
  runDate        String? /// run_date, as printed
  topMkb         Float? /// top_mkb — top of the string / liner hanger
  com            String?
  /// The well-level string this day's run belongs to (reports 04 and 05).
  /// Nullable: the daily editor never sets it, and a run nobody has recognised
  /// simply stays unlinked.
  casingStringId String?
  report         EntryReport   @relation(fields: [reportId], references: [id], onDelete: Cascade)
  casingString   CasingString? @relation(fields: [casingStringId], references: [id], onDelete: SetNull)

  @@index([reportId, order])
}

/// Formation top — a.json `formations` unioned with the DR.xls columns.
///
/// The point of this block is PROGNOSED vs ACTUAL: `progTopMd` is where the
/// geologist expected the top, `depth` (final_top_md_mkb) is where it came in.
/// A single depth column cannot express that, which is why both exist.
model EntryFormationTop {
  id            String      @id @default(cuid())
  reportId      String
  order         Int         @default(0)
  formation     String? /// formation_name
  /// final_top_md_mkb — where the top ACTUALLY came in.
  depth         Float?
  secondDepth   Float?
  type          String?
  // ── a.json formations additions ──
  progTopMd     Float? /// prog_top_md_mkb — prognosed top
  finalTopTvd   Float? /// final_top_tvd_mkb
  thickM        Float? /// thick_m
  drilledRopMHr Float? /// drilled_rop_m_hr
  /// lith_des — comma-separated lithology codes, e.g. "Lst,Mrl,Clst,Gyp".
  lithDes       String?
  report        EntryReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([reportId, order])
}

/// Directional survey station — a.json `directional_survey`.
/// Units are fixed by that schema: md/tvd in mKB, angles in degrees, NS/EW/VS in
/// metres, DLS and build rate per 30 m. Field names stay short (md/inc/azi/…);
/// the units live in the UI labels and here.
model EntrySurvey {
  id       String      @id @default(cuid())
  reportId String
  order    Int         @default(0)
  md       Float? /// md_mkb
  inc      Float? /// incl_deg
  azi      Float? /// azm_deg
  tvd      Float? /// tvd_mkb
  ns       Float? /// ns_m
  ew       Float? /// ew_m
  vs       Float? /// vs_m — vertical section
  dls      Float? /// dls_deg_30m
  build    Float? /// build_deg_30m
  report   EntryReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([reportId, order])
}

/// Drilling parameters — a.json `drilling_parameters`: one row per drilled
/// interval. A trailing partial row with only circulating time and no depths is
/// normal (circulating without progress), so every column is nullable.
///
/// This is a finer granularity than the bit record: a single bit run covers many
/// intervals, each with its own WOB / RPM / flow / SPP.
model EntryDrillingParameter {
  id              String         @id @default(cuid())
  reportId        String
  order           Int            @default(0)
  startMkb        Float? /// start_mkb
  endDepthMkb     Float? /// end_depth_mkb
  drillTimeHr     Float? /// drill_time_hr
  slideTimeHr     Float? /// slide_time_hr
  circTimeHr      Float? /// circ_time_hr
  intRopMHr       Float? /// int_rop_m_hr
  drillTq         Float? /// drill_tq
  rpm             Float? /// rpm
  qFlowGpm        Float? /// q_flow_gpm
  sppPsi          Float? /// spp_psi
  wob1000Lbf      Float? /// wob_1000lbf
  // ── reports 06 / 07 columns ──
  /// Which hole this interval was drilled in (reports 02, 06 and 07 all print a
  /// wellbore name). Nullable; the assembler falls back to the well's first.
  wellboreId      String?
  drillStrWtKlbf  Float? /// Drill Str Wt (1000lbf)
  puStrWtKlbf     Float? /// PU Str Wt (1000lbf)
  soStrWtKlbf     Float? /// SO Str Wt (1000lbf) — report 07 only
  offBottomTorque Float? /// Off Bottom Torque — report 07 only
  // Report 07's underbalanced / air-drilling row. Blank on a mud well, but the
  // sheet prints the labels, so there has to be somewhere to put them.
  qGasInjM3Min    Float? /// Q Gas Inj
  tInjC           Float? /// T Inj
  pBhAnnPsi       Float? /// P BH Ann
  tBhC            Float? /// T BH
  pSurfAnnulusPsi Float? /// P Surf Annulus
  tSurfAnnulusC   Float? /// T Surf Annulus
  qLiqReturnGpm   Float? /// Q Liq Return
  qGasReturnM3Min Float? /// Q Gas Return
  report          EntryReport    @relation(fields: [reportId], references: [id], onDelete: Cascade)
  /// The BHA run that drilled this interval — report 02 scopes its parameter
  /// table and its WOB / RPM / flow ranges to one run.
  bhaRunId        String?
  wellbore        EntryWellbore? @relation(fields: [wellboreId], references: [id], onDelete: SetNull)
  bhaRun          EntryBhaRun?   @relation(fields: [bhaRunId], references: [id], onDelete: SetNull)

  @@index([reportId, order])
  @@index([wellboreId])
}

model EntryTimeEntry {
  id            String      @id @default(cuid())
  reportId      String
  order         Int         @default(0)
  group         String?
  type          String?
  activity      String?
  hours         Float?
  // ── OIEC / WellView activity coding (see the Wv* lookup tables below) ──
  //
  // PLAIN nullable strings with NO foreign key, on purpose. The code system is
  // advisory: an entry whose letter/detail pair is not in the Time Breakdown
  // Matrix raises an amber warning in the editor and saves unchanged. A real FK
  // would reject the row, and every existing free-text entry must keep loading.
  /// Main Operation letter — WvMainOperation.code, "A".."U".
  opLetter      String?
  /// Operation Detail — WvOperationDetail.code, zero-padded "01".."33".
  opDetail      String?
  /// Time-classification indicator — WvTimeIndicator.code, P/U/T/X/N.
  timeIndicator String?
  /// Which phase this interval was charged to (report 11's day-centric fallback
  /// for actual phase duration when phase datetimes were never entered).
  phaseId       String?
  report        EntryReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  phase         JobPhase?   @relation(fields: [phaseId], references: [id], onDelete: SetNull)

  @@index([reportId, order])
  @@index([phaseId])
}

model EntryOperation {
  id            String      @id @default(cuid())
  reportId      String
  order         Int         @default(0)
  /// The composite code as printed, e.g. "E3-P" — or a legacy numeric code, or
  /// the literal "INACTIVE". Stays free text; the three parsed parts below are
  /// filled alongside it, never instead of it.
  opCode        String?
  /// Parsed from opCode when it matches {letter}{detail}-{indicator}; see the
  /// EntryTimeEntry note above for why these carry no foreign key.
  opLetter      String?
  opDetail      String?
  timeIndicator String?
  /// Reports 06 / 07's "Code 2" — the alpha activity code printed beside the
  /// numeric one (CSG, RR, DRLCMT, DRLG on the sample).
  opCode2       String?
  /// Report 07's "Problem?" / "Prob Hrs" pair: was this interval trouble, and
  /// how much of it was.
  isProblem     Boolean     @default(false)
  probHr        Float?
  /// "Prob Ref #" — the 1-BASED ORDINAL (order + 1) of the EntryIntervalProblem
  /// row in this day's list, NOT a foreign key. The daily PUT replaces child
  /// rows wholesale, so every save mints new ids and a real FK would dangle;
  /// the ordinal is also exactly what the report prints.
  problemRef    Int?
  fromTime      String?
  toTime        String?
  remarks       String?
  report        EntryReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([reportId, order])
}

/// Supervisors Contact — a.json `supervisors_contact`.
///
/// A repeating table, NOT the six fixed DR.xls name slots (wellSiteSupt,
/// opnSupt, …): the PEDC sheet lists whoever is on tour — Head of Operation,
/// Night Drilling Sup., POGC Rep., Rig OIM — and those roles vary per rig, so
/// fixed slots would drop rows on some reports and leave blanks on others.
/// Both live on the report; the DR.xls slots stay for the office sheet.
model EntrySupervisor {
  id         String      @id @default(cuid())
  reportId   String
  order      Int         @default(0)
  jobContact String? /// job_contact
  position   String? /// position
  /// Reports 06 and 07 print this list as "Daily Contacts — Job Contact, Mobile".
  mobile     String?
  report     EntryReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([reportId, order])
}

/// On-Board Companies — a.json `onboard_companies`. The POB breakdown behind
/// the header's head_count.
model EntryOnboardCompany {
  id            String      @id @default(cuid())
  reportId      String
  order         Int         @default(0)
  company       String? /// company
  count         Int? /// count — persons from that company
  note          String? /// note — role, e.g. Client / Operator / Drilling Unit Service
  /// Report 07's "Personnel Log" groups the day's people by this:
  /// "Contractor" | "Service" | "Operator". Distinct from `company`, which
  /// names the firm — several companies can share one type.
  personnelType String?
  /// Total worked hours for this group — the log's third column.
  totWorkTimeHr Float?
  report        EntryReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([reportId, order])
}

/// HSE Drill Schedule — a.json `hse_drill_schedule`.
///
/// A FIXED row set (BOP Test, H2S Drill, Fire Drill, Abandon Drill), like the
/// solid-control block. a.json is explicit that the rows print even when blank,
/// so an undrilled type is stored as a row with null date, never omitted.
model EntryHseDrill {
  id              String      @id @default(cuid())
  reportId        String
  /// "BOP Test" | "H2S Drill" | "Fire Drill" | "Abandon Drill"
  type            String
  /// date as PRINTED (the PEDC sheet uses Gregorian M/D/YYYY here, not Jalali).
  date            String?
  daysToNextCheck Float? /// days_to_next_check
  report          EntryReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@unique([reportId, type])
}

/// Bulk Material — a.json `bulk_material`.
///
/// Distinct from EntryChemical, which is a.json `mud_additive_balance`: this one
/// tracks rig bulks (barite, cement, diesel, drill/fresh water) in MT / liter /
/// m³ and carries `returned` + `note`, which the additive balance has no column
/// for. Merging the two would silently lose the returned volumes.
model EntryBulkMaterial {
  id            String      @id @default(cuid())
  reportId      String
  order         Int         @default(0)
  supplyItemDes String? /// supply_item_des
  unitLabel     String? /// unit_label — MT, liter, m3
  consumed      Float?
  received      Float?
  returned      Float?
  onLoc         Float? /// on_loc
  note          String?
  report        EntryReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([reportId, order])
}

/// Wellhead Component — a.json `wellhead_component`.
model EntryWellheadComponent {
  id          String      @id @default(cuid())
  reportId    String
  order       Int         @default(0)
  installDate String? /// install_date, as printed
  sizeIn      Float? /// size_in
  type        String?
  make        String?
  /// Model and serial number. NOT in a.json's `wellhead_component`, but report
  /// 04 prints both beside the make — the archive simply never carried them, and
  /// a spool without its serial cannot be traced back to its certificate.
  model       String?
  sn          String?
  wpPsi       Float? /// wp_psi — working pressure
  com         String?
  report      EntryReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([reportId, order])
}

/// Well Control — SCR (slow circulation rates), a.json `well_control_scr`.
/// One row per pump / rate; these are the kill-sheet numbers.
model EntryScrRate {
  id         String        @id @default(cuid())
  reportId   String
  order      Int           @default(0)
  pumpNo     String? /// pump_no
  depthMkb   Float? /// depth_mkb
  strokesSpm Float? /// strokes_spm
  effPct     Float? /// eff_pct
  pPsi       Float? /// p_psi
  qFlowGpm   Float? /// q_flow_gpm
  /// The rig pump this reading belongs to, so reports 06 and 07 can print one
  /// block per pump with its plant data beside the day's numbers.
  mudPumpId  String?
  report     EntryReport   @relation(fields: [reportId], references: [id], onDelete: Cascade)
  mudPump    EntryMudPump? @relation(fields: [mudPumpId], references: [id], onDelete: SetNull)

  @@index([reportId, order])
  @@index([mudPumpId])
}

/// Support Vessels — a.json `support_vessels` (offshore only).
model EntrySupportVessel {
  id            String      @id @default(cuid())
  reportId      String
  order         Int         @default(0)
  vesselName    String? /// vessel_name
  vesselType    String? /// vessel_type
  arrivalDate   String? /// arrival_date, as printed
  departureDate String? /// departure_date
  note          String?
  report        EntryReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([reportId, order])
}

/// Formation Integrity Test — a.json `formation_integrity_test`.
/// An OBJECT in a.json, not a table: at most one FIT/LOT per report, so this is
/// 1:1 on reportId like EntryMud.
model EntryFit {
  id                        String      @id @default(cuid())
  reportId                  String      @unique
  testType                  String? /// test_type — FIT or LOT
  testDate                  String? /// test_date, as printed
  lastCasingStringRun       String? /// last_casing_string_run
  depthMkb                  Float? /// depth_mkb
  tvdMkb                    Float? /// tvd_mkb
  appliedSurfacePressurePsi Float? /// applied_surface_pressure_psi
  fluidDensityPpg           Float? /// fluid_density_ppg
  volumePumpedBbl           Float? /// volume_pumped_bbl
  leakOffPressurePsi        Float? /// leak_off_pressure_psi
  leakOffEqDensityPpg       Float? /// leak_off_equivalent_fluid_density_ppg
  report                    EntryReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
}

/// Marine Conditions — a.json `marine_conditions` (offshore only), 1:1 per report.
///
/// TYPED fields, deliberately. The DR.xls sheet crams these into two free-text
/// cells (EntryReport.windSpeedDir "12 kt NW" and waveVisible), which makes wind
/// speed impossible to chart or filter. Those two stay for the office sheet; this
/// block is the structured version.
model EntryMarine {
  id           String      @id @default(cuid())
  reportId     String      @unique
  swellHtM     Float? /// swell_ht_m
  visibilityKm Float? /// visibility_km
  windDir      String? /// wind_dir
  windSpdKnots Float? /// wind_spd_knots
  tHighC       Float? /// t_high_c
  waveHtM      Float? /// wave_ht_m
  com          String?
  report       EntryReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
}

/// Drill string — a.json `drill_strings`: one entry PER BHA run in the day.
///
/// This replaces the flat EntryBhaItem list. a.json nests the component list
/// inside each string precisely because a day can run two BHAs; with a flat list
/// there is no way to say which components made up which string once the second
/// one goes in the hole, and the per-BHA header figures (depth in, date in,
/// objective, its own drilling/circulating/rotating/sliding hours) have nowhere
/// to live at all.
model EntryDrillString {
  id                String                      @id @default(cuid())
  reportId          String
  order             Int                         @default(0)
  name              String? /// drill_string_name, e.g. 24" Clean-out BHA
  bhaNo             Int? /// bha_no
  depthInMkb        Float? /// depth_in_mkb
  dateIn            String? /// date_in, as printed
  objective         String? /// bha_objective
  depthDrilledM     Float? /// depth_drilled_m
  drillingTimeHr    Float? /// drilling_time_hr — this BHA's own hours, not the day's
  circulatingTimeHr Float? /// circulating_time_hr
  rotatingTimeHr    Float? /// rotating_time_hr
  slidingTimeHr     Float? /// sliding_time_hr
  /// Report 07's "String Wt (1000lbf)". Stored, not derived: the hook load is
  /// read off the weight indicator, not computed from the tally.
  stringWtKlbf      Float?
  note              String?
  report            EntryReport                 @relation(fields: [reportId], references: [id], onDelete: Cascade)
  /// The multi-day run this day's slice belongs to (reports 02 and 03).
  bhaRunId          String?
  components        EntryDrillStringComponent[]
  bhaRun            EntryBhaRun?                @relation(fields: [bhaRunId], references: [id], onDelete: SetNull)

  @@index([reportId, order])
}

/// One item in a drill string's make-up — a.json `drill_strings[].components`.
/// `cumLenM` is the running total the sheet prints; it is stored as recorded
/// rather than derived, because the printed sheet is the record of truth.
model EntryDrillStringComponent {
  id            String           @id @default(cuid())
  drillStringId String
  order         Int              @default(0)
  itemDes       String? /// item_des
  serv          String? /// serv — owning service company
  sn            String? /// sn
  odIn          Float? /// od_in
  idIn          Float? /// id_in
  jts           Int? /// jts
  lenM          Float? /// len_m
  cumLenM       Float? /// cum_len_m
  /// Report 07's "Top Thread" column, e.g. IF, API REG, 4.5IF.
  topThread     String?
  // ── report 02's fuller tally ──
  /// Mass per unit length in kg/m — METRIC, to match `lenM`. The samples print
  /// lb/ft; mixing the two silently scales a string weight by 3.28.
  massPerLenKgM Float?
  grade         String? /// e.g. S135, L80
  driftIn       Float?
  gaugeIn       Float?
  connections   String? /// e.g. 4.5IF, 6.62 API REG
  com           String?
  drillString   EntryDrillString @relation(fields: [drillStringId], references: [id], onDelete: Cascade)

  @@index([drillStringId, order])
}

// ═══════════════════════════════════════════════════════════════════════════
//  WellView report suite — Tier 0 foundation
//
//  The Entry* block above is DAY-CENTRIC: everything hangs off one EntryReport
//  per well-day. The 30 WellView reports in Wellview/ are JOB-CENTRIC — they
//  print AFE numbers, phase plan-vs-actual and cumulative cost for a drilling
//  campaign, none of which a day can own. This block is that missing spine,
//  bridged onto the daily store by the nullable EntryReport.jobId / .phaseId
//  above.
//
//  Two naming families:
//    Wv*   — seeded code tables from the OIEC "Time Distribution Procedure"
//            and the one-page Wellview code sheet. Read-only to users.
//    Job / Afe / CostItem / … — the campaign spine. Clean domain names, never
//            Entry*-prefixed: they are not per-day records.
//
//  See docs/wellview-tier0-tier1-plan.md.
// ═══════════════════════════════════════════════════════════════════════════

/// Wellview Code 1 — the 21 Main-Operation letters. Indexes the rows of the
/// Time Breakdown Matrix (Tab. 7-1) and is the pick-list behind
/// EntryTimeEntry.opLetter / EntryOperation.opLetter.
model WvMainOperation {
  /// "A".."U", the one-page sheet's letters.
  code        String         @id
  /// Verbatim sheet wording — including its typos ("Slike Line"): the printed
  /// report has to match the sheet the crew codes from.
  name        String
  order       Int
  /// The Tab. 7-1 row label where it differs from the sheet (C, F, G, H, O, P).
  matrixLabel String?
  /// False for U only: the sheet splits Wellhead (C) from BOP (U), the matrix
  /// folds them into one row C — so U has no matrix row to validate against.
  onMatrix    Boolean        @default(true)
  /// R / S / T — "shall be used only for rig less operations" (matrix footnote).
  riglessOnly Boolean        @default(false)
  /// Source errata worth surfacing next to the code.
  note        String?
  cells       WvMatrixCell[]

  @@index([order])
}

/// Wellview Code 2 — the 33 Operation-Detail numbers; the matrix columns.
model WvOperationDetail {
  /// Zero-padded exactly as printed: "01".."33".
  code       String         @id
  /// 1..33 — the matrix column index and the join key for WvMatrixCell.
  num        Int            @unique
  name       String
  /// The procedure §6 definition, verbatim.
  definition String?
  /// False for 33 (Well Control) only — on the sheet, but no matrix column.
  onMatrix   Boolean        @default(true)
  note       String?
  cells      WvMatrixCell[]
}

/// The Time Breakdown Matrix (Tab. 7-1) as ONE ROW PER MARKED CELL — exactly
/// 437 rows. This is the SQLite encoding of the letter × detail validity
/// matrix, and it drives a WARNING, never a constraint: the matrix's own
/// footnote says "any other combination is possible".
model WvMatrixCell {
  /// WvMainOperation.code — rows A..T (U has no matrix row).
  letter    String
  /// WvOperationDetail.num — columns 1..32 (33 has no column).
  detailNum Int
  /// Provenance for a corrected cell, e.g. row A column 9, printed "A4".
  note      String?
  operation WvMainOperation   @relation(fields: [letter], references: [code], onDelete: Cascade)
  detail    WvOperationDetail @relation(fields: [detailNum], references: [num], onDelete: Cascade)

  /// The composite key IS the validation lookup, and its prefix serves
  /// "which details are valid for letter X".
  @@id([letter, detailNum])
  @@index([detailNum])
}

/// Time-classification indicator (procedure §3) — appended to every activity
/// code and what drives the planned / unplanned / trouble statistics.
model WvTimeIndicator {
  /// "P" | "U" | "T" | "X" | "N"
  code       String  @id
  name       String
  definition String?
  order      Int
}

/// The one-page sheet's own 4-entry "Report Code" list.
///
/// A SEPARATE table from WvTimeIndicator deliberately: the letters collide with
/// different meanings — sheet P = Productive, procedure P = Planned; sheet U =
/// Un-Planned, procedure U = Unplanned but T/N differ too. Merging the two
/// vocabularies would silently mis-classify time (spec errata 5).
model WvReportCode {
  /// "P" | "N" | "T" | "U"
  code  String @id
  name  String
  order Int
}

/// Working Phases (Tab. 4-1) — the OIEC roll-up target that Main Operations
/// aggregate into. Soft-tagged from JobPhase.workingPhaseCode.
model WvWorkingPhase {
  /// Slug, e.g. "DRILLING" | "WELL_ABANDONING" | "PRODUCTION_MAINTENANCE".
  code     String  @id
  name     String
  purpose  String?
  /// The "STARTING PHASE" trigger, verbatim. Null where the source prints "—".
  startsAt String?
  /// The "END PHASE" trigger, verbatim.
  endsAt   String?
  order    Int

  @@index([order])
}

/// One JOB on a well — the campaign reports 01, 10, 11, 12 and 22 are scoped
/// to. A well can carry several (report 22 prints "Drilling - original" and
/// "Completion" for one well).
model Job {
  id                       String   @id @default(cuid())
  wellId                   String
  /// Print order when a well has several jobs; 0 = the current/primary job.
  order                    Int      @default(0)
  /// Internal label, not printed on any sample.
  name                     String?
  /// "Drilling" | "Completion" | "Workover" | "Abandonment"
  category                 String?
  /// "Drilling" | "Drilling - original" | "Drilling - sidetrack" | "Re-entry" | "Completion"
  primaryJobType           String?
  /// Blank in every sample, but report 10 always prints the label.
  secondaryJobType         String?
  /// "Job Complete" | "In Progress" | "Planned" | "Suspended"
  status1                  String?
  /// Jalali "YYYY/MM/DD" (or "YYYY/MM/DD HH:mm" where the sample prints a time).
  plannedStartDate         String?
  startDate                String?
  minPlannedEndDate        String?
  mostLikelyPlannedEndDate String?
  maxPlannedEndDate        String?
  endDate                  String?
  /// mKB. The samples print ftKB — layout is reproduced, units are ours.
  targetDepth              Float?
  targetFormation          String?
  /// The JOB narrative (report 01's "Summary"). NOT EntryReport.description,
  /// which is the per-DAY summary — the two are different texts.
  summary                  String?
  // ── report 22's job savings/problem block ──
  possCostSave             Float?
  possTimeSaveHr           Float?
  estProblemCost           Float?
  estLostTimeHr            Float?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  well      EntryWell     @relation(fields: [wellId], references: [id], onDelete: Cascade)
  phases    JobPhase[]
  afes      Afe[]
  costItems CostItem[]
  reports   EntryReport[]

  @@index([wellId, order])
}

/// One ACTUAL phase of a job — report 10's table rows, report 11's bar groups.
///
/// Phase boundaries land at arbitrary times of day (the sample's are 09:00,
/// 21:45, 06:45, 12:15 …), so they cannot be recovered from the day-centric
/// EntryReport store and are stored here as date+time.
model JobPhase {
  id               String   @id @default(cuid())
  jobId            String
  /// Chronological sequence — also the running-sum order for every cumulative
  /// column on reports 10 and 11.
  order            Int      @default(0)
  /// "Mob and Rig up" | "Surface" | "Intermediate" | "Production" | "Mob"
  phaseType1       String?
  /// "Drill-Vertical" | "Drill-Deviation Control" | "Run and Cement Casing" |
  /// "Log" | "Log & Core" | "NU" | "Test and Drill Out" | "Demob"
  phaseType2       String?
  /// Jalali "YYYY/MM/DD HH:mm" — date AND time; a date alone makes the printed
  /// Actual Dur unreproducible.
  actualStartDate  String?
  actualEndDate    String?
  /// mKB at full precision, never the printed 1 dp: row 1's printed Cost/Depth
  /// of 576.17 only comes out of 321.52, not 321.5.
  actualStartDepth Float?
  actualEndDepth   Float?
  /// Soft tag onto WvWorkingPhase.code — a plain string, no FK. WellView's
  /// "Phase Type 1" and the OIEC working phases are different vocabularies.
  workingPhaseCode String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  job         Job              @relation(fields: [jobId], references: [id], onDelete: Cascade)
  plan        JobPhasePlan?
  costItems   CostItem[]
  reports     EntryReport[]
  timeEntries EntryTimeEntry[]

  @@index([jobId, order])
}

/// The PLANNED half of a phase, 1:1 with JobPhase.
///
/// Kept in its own row rather than as nullable columns on JobPhase so that a
/// plan can exist before any actuals, and so a phase with no plan contributes
/// nothing to report 10's planned cumulative columns instead of contributing a
/// fabricated zero.
model JobPhasePlan {
  id                String @id @default(cuid())
  jobPhaseId        String @unique
  /// mKB.
  startDepth        Float?
  endDepth          Float?
  /// Report 10 "Dur ML (days)" / report 11 "Planned Likely Duration".
  durMostLikelyDays Float?
  /// Report 10 "Planned Likely Phase Cost".
  costMostLikely    Float?

  jobPhase JobPhase @relation(fields: [jobPhaseId], references: [id], onDelete: Cascade)
}

/// The authorization document for a job. Normally one; several are allowed (a
/// re-AFE'd sidetrack, report 22's separate completion AFE "1234567C").
model Afe {
  id           String   @id @default(cuid())
  jobId        String
  /// 0 = the primary AFE, the one reports 01 / 10 / 11 print.
  order        Int      @default(0)
  /// As PRINTED — TEXT, never numeric: "1234567C" is a real AFE number.
  afeNumber    String?
  description  String?
  /// The approval document's CONTROL total. The reports print the SUM of the
  /// cost rows, not this; it is kept for the reconciliation warning and as the
  /// last-resort fallback when no cost row carries an AFE amount.
  amount       Float?
  approvedDate String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  job         Job             @relation(fields: [jobId], references: [id], onDelete: Cascade)
  lines       AfeLine[]
  supplements AfeSupplement[]

  @@index([jobId, order])
}

/// An approved supplement — the "+ Supp" half of "Total AFE + Supp Amount".
/// Individual rows, not one total column: report 01 prints them per cost line
/// (50,000 + 75,000 = the 125,000 the totals block shows).
model AfeSupplement {
  id           String  @id @default(cuid())
  afeId        String
  order        Int     @default(0)
  number       String?
  amount       Float?
  approvedDate String?

  afe       Afe        @relation(fields: [afeId], references: [id], onDelete: Cascade)
  costItems CostItem[]

  @@index([afeId, order])
}

/// One authorized budget line of an AFE.
///
/// NOT the same thing as CostItem: this is what finance signed, CostItem is the
/// job cost-sheet row report 01 prints. Keeping them apart is what lets a cost
/// row exist with no AFE line (a field estimate nobody authorized) and an AFE
/// line exist with no spend yet.
model AfeLine {
  id          String  @id @default(cuid())
  afeId       String
  /// Nullable: a line may be typed before its code exists in the chart.
  costCodeId  String?
  order       Int     @default(0)
  /// Free-text description when there is no cost code yet.
  description String?
  amount      Float?

  afe       Afe        @relation(fields: [afeId], references: [id], onDelete: Cascade)
  costCode  CostCode?  @relation(fields: [costCodeId], references: [id], onDelete: SetNull)
  costItems CostItem[]

  @@index([afeId, order])
  @@index([costCodeId])
}

/// The company's two-level chart of accounts — report 01's "Code 1" / "Code 2"
/// / "Cost Des" columns. Company-wide, not per job or per well.
///
/// Ships EMPTY. The sample's 1200/1210 … 7000/7602 are the vendor's demo
/// accounts; seeding them would put fictional codes in front of the finance
/// team. They exist only as a dev fixture for the report-01 layout test.
model CostCode {
  id           String   @id @default(cuid())
  /// Major account as printed, e.g. "1200". TEXT so leading zeros survive.
  code1        String
  /// Sub-account as printed, e.g. "1210".
  code2        String
  /// Report 01's "Cost Des", e.g. "Subsea wellhead equipment".
  description  String
  /// Optional grouping ("Drilling" / "Completion"); not printed.
  projectScope String?
  /// Retire a code without deleting the rows that reference it.
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  afeLines  AfeLine[]
  costItems CostItem[]

  @@unique([code1, code2])
}

/// ONE PRINTED ROW of report 01's "Job Cost Summary" — and the single source of
/// every money figure on reports 01, 06, 07, 10, 11 and 12.
///
/// There is deliberately NO unique constraint on (jobId, costCodeId): the
/// sample prints 7000/7602 twice, once as an AFE+supplement row and once as a
/// field-estimate-only row with a negative variance. A code pair MUST be able
/// to repeat as separate rows.
model CostItem {
  id            String   @id @default(cuid())
  jobId         String
  /// Phase attribution. Without it, report 10's "Actual Phase Field Est" column
  /// and report 11's actual-cost line cannot be produced at all.
  phaseId       String?
  /// Nullable: an uncoded row prints blank code cells, as the sample does.
  costCodeId    String?
  /// The AFE line that authorized this row, when it came from the AFE.
  afeLineId     String?
  /// The supplement this row's suppAmount belongs to.
  supplementId  String?
  /// Source insertion order — breaks ties in the printed code1/code2 sort.
  order         Int      @default(0)
  /// Overrides CostCode.description when set (the "Cost Des" of an uncoded row).
  description   String?
  afeAmount     Float?
  suppAmount    Float?
  fieldEstimate Float?
  finalInvoice  Float?
  /// The bucket the daily header's mud roll-up filters on:
  /// "mud" | "rig" | "tubulars" | "services" | "logistics" | "other".
  category      String?
  /// Jalali "YYYY/MM/DD" — lets reports 06 / 07 / 14 slice cost by day without
  /// a second per-report cost table that would have to agree with this one.
  costDate      String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  job        Job            @relation(fields: [jobId], references: [id], onDelete: Cascade)
  /// SetNull, never Cascade — deleting a phase must not delete the cost.
  phase      JobPhase?      @relation(fields: [phaseId], references: [id], onDelete: SetNull)
  costCode   CostCode?      @relation(fields: [costCodeId], references: [id], onDelete: SetNull)
  afeLine    AfeLine?       @relation(fields: [afeLineId], references: [id], onDelete: SetNull)
  supplement AfeSupplement? @relation(fields: [supplementId], references: [id], onDelete: SetNull)

  @@index([jobId, order])
  @@index([phaseId])
  @@index([costCodeId])
  @@index([jobId, costDate])
}

// ═══════════════════════════════════════════════════════════════════════════
//  WellView report suite — Tier 1 (reports 06, 07, 02, 03)
//
//  Reports 06 and 07 print mostly from the daily sheet the crew already fills.
//  These are the things it has no home for: the well's holes, the rig's pumps,
//  and the EVENTS — problems, lessons, kicks, losses, incidents.
//
//  Where an event lives is decided by the sample, not by taste:
//    • a row with a TIME and no date cannot outlive the day → per report
//      (EntryIntervalProblem, EntrySafetyCheck, EntrySafetyIncident);
//    • a row with TWO dates is a register entry the daily report reprints on
//      every day its range covers → per well (EntryIntervalLesson, EntryKick,
//      EntryLostCirculation). The sample's lesson runs eight days.
// ═══════════════════════════════════════════════════════════════════════════

/// A hole in the well. Reports 02, 06 and 07 all print a wellbore name, and the
/// Entry* block had no such concept (one EntryWell implied one hole).
/// Well-level, not per-day: "Original Hole / KO MD 1,381.2" is the same row on
/// every report day.
model EntryWellbore {
  id        String   @id @default(cuid())
  wellId    String
  order     Int      @default(0)
  name      String? /// e.g. "Original Hole", "ST-1"
  /// "Original Hole" | "Sidetrack" | "Re-drill" | "Lateral"
  kind      String?
  /// Kick-off measured depth, mKB. EntryReport.kop stays the DR.xls per-day
  /// free text and is NOT migrated into this column.
  koMdMkb   Float?
  createdAt DateTime @default(now())

  well               EntryWell                @relation(fields: [wellId], references: [id], onDelete: Cascade)
  drillingParameters EntryDrillingParameter[]
  bhaRuns            EntryBhaRun[]
  holeSections       HoleSection[]
  casingStrings      CasingString[]
  cementJobs         CementJob[]

  @@index([wellId, order])
}

/// A mud pump on the rig — reports 06 and 07 print one block per pump.
///
/// RIG-constant: the sample prints the same three pumps on every report day, so
/// this is the plant. The day's readings (pressure, slow speed, strokes,
/// efficiency) stay on EntryScrRate, which is already per-report and per-pump.
model EntryMudPump {
  id           String   @id @default(cuid())
  rigId        String
  order        Int      @default(0)
  pumpNo       String? /// as printed: "1", "2", "3" — what EntryScrRate.pumpNo matches
  manufacturer String? /// e.g. OILWELL
  model        String? /// e.g. A 1700-PT
  ratingHp     Float? /// "Pump Rating (hp)" on 07, "Pwr (hp)" on 06
  rodDiaIn     Float?
  strokeIn     Float?
  /// TEXT, not a number: the page prints the fraction "6 1/2".
  linerSizeIn  String?
  /// "Vol/Stk OR (bbl/stk)" — the OR is Override. Blank means the report falls
  /// back to the swept volume of the liner and stroke.
  volPerStkBbl Float?
  createdAt    DateTime @default(now())

  rig      EntryRig       @relation(fields: [rigId], references: [id], onDelete: Cascade)
  scrRates EntryScrRate[]

  @@index([rigId, order])
}

/// Report 07's "Drilling Mud Volumes" movement ledger.
///
/// Not a duplicate of EntryMud's volumes: those are the pit STATE at check time
/// (active / reserve / lost), this is what MOVED. The printed Cum columns are
/// running totals down the day's table and are computed, never stored.
model EntryMudVolume {
  id          String      @id @default(cuid())
  reportId    String
  order       Int         @default(0)
  action      String? /// e.g. "Mixed new mud", "Transferred to reserve"
  toWellBbl   Float?
  fromWellBbl Float?
  report      EntryReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([reportId, order])
}

/// Report 06's "Safety Checks" sidebar — one row per check, drill or meeting.
///
/// A SEPARATE model from EntryHseDrill, which is the fixed four-row recurring
/// SCHEDULE keyed by type and so cannot hold two safety meetings on one day.
/// Report 07's "Safety Check Summary" prints the schedule; this prints the day.
model EntrySafetyCheck {
  id       String      @id @default(cuid())
  reportId String
  order    Int         @default(0)
  time     String? /// HH:MM as printed
  /// "Safety Meeting" | "BOP Drill" | "Choke Drill" | "H2S Drill" | "Fire Drill"
  type     String?
  des      String? /// what the check covered
  report   EntryReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([reportId, order])
}

/// Report 07 page 2's "Safety Incidents". Per-day: the row carries a time and
/// no date at all, so the day is the report's. Feeds report 17 unchanged.
model EntrySafetyIncident {
  id       String      @id @default(cuid())
  reportId String
  order    Int         @default(0)
  time     String? /// HH:MM as printed
  /// "Near Miss" | "Incident" | "Accident"
  category String?
  type     String?
  subType  String? /// printed "SubTyp"
  cause    String?
  /// "Lost time?" — prints Yes / No. Nullable rather than defaulting to false:
  /// unanswered is not the same as answered "no".
  lostTime Boolean?
  severity String?
  report   EntryReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([reportId, order])
}

/// Report 07 page 2's "Interval Problems", and the target of the time log's
/// "Prob Ref #" ordinal.
///
/// PER-DAY, from the sample: the row carries a start date and NO end date, its
/// start and end depths are identical, its estimated lost time equals the day's
/// problem-time total, and the day's 18:15–18:45 log row references it.
model EntryIntervalProblem {
  id               String      @id @default(cuid())
  reportId         String
  /// The report prints `order + 1` as "Prob Ref #".
  order            Int         @default(0)
  /// "Equipment Trouble" | "Hole Trouble" | "Rig Failure" | "Logistical" |
  /// "Weather" | "Well Control" | "Other"
  problemType      String?
  problemSubType   String? /// the specific problem, e.g. ROV
  startDate        String? /// Jalali "YYYY/MM/DD"
  startTime        String? /// HH:MM
  startDepthMkb    Float?
  endDepthMkb      Float?
  /// Who the cost is charged to: "Operator" | "Contractor" | a service company.
  /// Report 15 pivots problem cost on exactly this, and nothing else in the
  /// Entry* block names a party.
  accountableParty String?
  estCost          Float?
  estLostTimeHr    Float?
  comment          String? /// prints as a full-width sub-row
  report           EntryReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([reportId, order])
}

/// Report 07 page 2's "Interval Lessons".
///
/// WELL-level: the sample's lesson runs 2000-02-21 → 2000-02-28 over 1,000 →
/// 2,650 ftKB. It is a register entry the daily report reprints on every day its
/// range covers, not a datum of any one day.
model EntryIntervalLesson {
  id              String    @id @default(cuid())
  wellId          String
  order           Int       @default(0)
  /// "Drilling" | "Casing" | "Cementing" | "Completion" | "HSE" | "Other"
  lessonType      String?
  startDate       String? /// Jalali "YYYY/MM/DD"
  endDate         String? /// the presence of BOTH dates is what proves it outlives a day
  startDepthMkb   Float?
  endDepthMkb     Float?
  estCostSaving   Float?
  estTimeSavingHr Float?
  comment         String?
  createdAt       DateTime  @default(now())
  well            EntryWell @relation(fields: [wellId], references: [id], onDelete: Cascade)

  @@index([wellId, order])
}

/// Report 07's "Kicks" well-control table. Well-level by the same two-date test
/// as the lessons: a kick taken at 23:00 and killed the next morning would
/// otherwise need two rows or a reopened report.
model EntryKick {
  id              String    @id @default(cuid())
  wellId          String
  order           Int       @default(0)
  kickDate        String? /// Jalali "YYYY/MM/DD"
  kickTime        String? /// HH:MM
  kickDepthMkb    Float?
  controlDate     String?
  controlTime     String?
  controlDepthMkb Float?
  /// "Gas" | "Oil" | "Water" | "Mixed"
  kickClass       String?
  killNotes       String? /// prints as a full-width sub-row under the table
  createdAt       DateTime  @default(now())
  well            EntryWell @relation(fields: [wellId], references: [id], onDelete: Cascade)

  @@index([wellId, order])
}

/// Report 07's "Lost Circulation" table. Well-level for the same reason — start
/// and end date are both printed columns.
///
/// Distinct from EntryMud.mudLostBbl and EntryReport.formationLoss, which are
/// the DAY's lost volume; this is the EVENT, with its own interval and total.
model EntryLostCirculation {
  id             String    @id @default(cuid())
  wellId         String
  order          Int       @default(0)
  startDate      String? /// Jalali "YYYY/MM/DD"
  topDepthMkb    Float?
  bottomDepthMkb Float?
  opsInProg      String? /// what was being done when losses started
  volLostTotBbl  Float? /// the event total, not the day's
  endDate        String?
  createdAt      DateTime  @default(now())
  well           EntryWell @relation(fields: [wellId], references: [id], onDelete: Cascade)

  @@index([wellId, order])
}

/// A BHA run, spanning the days it was in the hole — the row grain of report 02
/// (one page per run) and report 03 (one row per run for the whole well).
///
/// DELIBERATELY THIN. Everything the daily rows already carry — the assembly
/// name, depth in, date in, the drilling hours, the components, the bit — is
/// DERIVED at assembly time from `drillStrings`. Only facts no day-row can hold
/// are stored here.
///
/// `depthOutMkb` is the exception, and it is stored on purpose: a run can come
/// out on a day with no drilled interval at all (report 03's sample has runs
/// with no WOB or RPM recorded), so there is nothing to take a MAX over.
model EntryBhaRun {
  id          String   @id @default(cuid())
  wellId      String
  wellboreId  String?
  /// The run's identity, and the key the daily rows are matched on.
  bhaNo       Int?
  depthOutMkb Float?
  /// The day the assembly came out. Free text "as printed", the same convention
  /// as EntryDrillString.dateIn — report 02 prints the pair on one line, so the
  /// two halves must not be in different calendars.
  dateOut     String?
  timeOut     String? /// HH:MM
  /// The run-level comment. EntryDrillString.note stays the per-DAY note.
  comment     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  well               EntryWell                @relation(fields: [wellId], references: [id], onDelete: Cascade)
  wellbore           EntryWellbore?           @relation(fields: [wellboreId], references: [id], onDelete: SetNull)
  sensors            EntryBhaSensor[]
  drillStrings       EntryDrillString[]
  bitRuns            EntryBitRun[]
  drillingParameters EntryDrillingParameter[]

  @@unique([wellId, bhaNo])
  @@index([wellId])
  @@index([wellboreId])
}

/// Report 02's "Sensors" table. Run-level: the sensor package is a property of
/// the assembly and does not change while it is in the hole, so a per-day home
/// would make the crew retype it every morning.
model EntryBhaSensor {
  id           String      @id @default(cuid())
  bhaRunId     String
  order        Int         @default(0)
  sensorType   String? /// e.g. Gamma, Resistivity, Inclination, Vibration
  /// Distance from the bit, metres. NOT derivable from the component tally:
  /// `cumLenM` gives the distance to a COLLAR, while the sensor sits at its own
  /// offset inside that collar — which is the number this column prints.
  distFromBitM Float?
  note         String?
  bhaRun       EntryBhaRun @relation(fields: [bhaRunId], references: [id], onDelete: Cascade)

  @@index([bhaRunId, order])
}

// ═══════════════════════════════════════════════════════════════════════════
//  WellView report suite — Tier 2: casing, liner and cement (reports 04, 05)
//
//  The daily EntryCasingRun rows record "a string was run to this depth today".
//  These are the strings themselves: their tally joint by joint, their cement
//  job, and the hole sections they were run into. Well-level, because a casing
//  string outlives every day of the well and is printed on reports for years
//  afterwards.
//
//  The daily rows are NOT replaced. They stay as the crew's record of the day,
//  and `EntryCasingRun.casingStringId` bridges one to the other when a run is
//  recognised — nullable, so nothing that already saves stops saving.
// ═══════════════════════════════════════════════════════════════════════════

/// A hole section — report 04's "Sections" block: what size was drilled, and
/// between which depths. Well-level, and pointed at a wellbore because a
/// sidetrack drills its own sections.
model HoleSection {
  id         String   @id @default(cuid())
  wellId     String
  wellboreId String?
  order      Int      @default(0)
  /// "Section Des" — e.g. "Surface", "Intermediate".
  sectionDes String?
  /// Hole size in inches, as printed: TEXT because the sheet shows 17 1/2.
  sizeIn     String?
  actTopMkb  Float?
  actBtmMkb  Float?
  createdAt  DateTime @default(now())

  well     EntryWell      @relation(fields: [wellId], references: [id], onDelete: Cascade)
  wellbore EntryWellbore? @relation(fields: [wellboreId], references: [id], onDelete: SetNull)

  @@index([wellId, order])
}

/// A casing or liner string — the row grain of report 05 and the subject of
/// report 04's page.
model CasingString {
  id                String   @id @default(cuid())
  wellId            String
  wellboreId        String?
  order             Int      @default(0)
  /// "Structural Casing", "Conductor Pipe", "Surface Casing", "Production Casing".
  description       String?
  /// Run date as printed — the same free-text convention as the daily rows.
  runDate           String?
  setDepthMkb       Float?
  /// Set tension. The samples print kips; we print kN.
  setTensionKn      Float?
  /// "String Nominal OD (in)" — TEXT, the sheet prints 13 3/8.
  stringNominalOdIn String?
  stringMinDriftIn  Float?
  /// Free text exactly as the sample prints it ("2/joint on shoe track.").
  centralizers      String?
  scratchers        String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  well       EntryWell         @relation(fields: [wellId], references: [id], onDelete: Cascade)
  wellbore   EntryWellbore?    @relation(fields: [wellboreId], references: [id], onDelete: SetNull)
  components CasingComponent[]
  cementJobs CementJob[]
  dailyRuns  EntryCasingRun[]

  @@index([wellId, order])
}

/// One line of a string's tally. `Len` and the depths are the printed columns;
/// the sample gives all three, so none is derived from the others — a tally
/// with a gap in it is a real thing and must survive the round trip.
model CasingComponent {
  id             String  @id @default(cuid())
  casingStringId String
  order          Int     @default(0)
  jts            Int?
  itemDes        String? /// "Casing Joint(s)", "Float Collar", "Float Shoe", "Cross Over"
  /// TEXT: the sheet prints 13 3/8 beside 10.752 in the same column.
  odIn           String?
  idIn           Float?
  /// Mass per unit length in kg/m — METRIC, to match `lenM`. The samples print
  /// lb/ft; carrying both units in one tally is how a string weight ends up
  /// 3.28× wrong.
  massPerLenKgM  Float?
  grade          String? /// X-52, K-55, L-80
  topThread      String? /// RL-4HT, BTC, VAM, LTC
  topMkb         Float?
  btmMkb         Float?
  lenM           Float?
  pBurstPsi      Float?
  pCollapsePsi   Float?

  casingString CasingString @relation(fields: [casingStringId], references: [id], onDelete: Cascade)

  @@index([casingStringId, order])
}

/// A cement job on a string — report 04's "Cement" block.
model CementJob {
  id                String   @id @default(cuid())
  casingStringId    String
  wellboreId        String?
  order             Int      @default(0)
  description       String? /// "Surface Casing Cement"
  startDate         String?
  endDate           String?
  evaluationMethod  String? /// "Temperature Log", "CBL", "USIT"
  evaluationResults String?
  comment           String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  casingString CasingString   @relation(fields: [casingStringId], references: [id], onDelete: Cascade)
  wellbore     EntryWellbore? @relation(fields: [wellboreId], references: [id], onDelete: SetNull)
  stages       CementStage[]

  @@index([casingStringId, order])
}

/// One stage of a cement job — the pumping record.
model CementStage {
  id                     String   @id @default(cuid())
  cementJobId            String
  order                  Int      @default(0)
  topDepthMkb            Float?
  bottomDepthMkb         Float?
  /// "Full Return?" — nullable, because unanswered is not the same as "no".
  fullReturn             Boolean?
  volCementM3            Float?
  topPlug                Boolean?
  bottomPlug             Boolean?
  qPumpInitM3Min         Float?
  qPumpFinalM3Min        Float?
  avgPumpRateM3Min       Float?
  finalPumpPressurePsi   Float?
  plugBumpPressurePsi    Float?
  pipeReciprocated       Boolean?
  strokeM                Float?
  reciprocationRateSpm   Float?
  pipeRotated            Boolean?
  pipeRpm                Float?
  taggedDepthMkb         Float?
  tagMethod              String? /// "Drill Bit", "Tubing", "Wireline"
  depthPlugDrilledOutMkb Float?
  drillOutDiameterIn     String?
  drillOutDate           String?

  cementJob CementJob     @relation(fields: [cementJobId], references: [id], onDelete: Cascade)
  fluids    CementFluid[]

  @@index([cementJobId, order])
}

/// A fluid pumped in a stage — lead, tail, spacer, flush.
model CementFluid {
  id                     String  @id @default(cuid())
  cementStageId          String
  order                  Int     @default(0)
  fluidType              String? /// "Lead" | "Tail" | "Spacer" | "Flush"
  fluidDescription       String? /// "Neat", "Class G + 35% silica"
  amountSacks            Float?
  cementClass            String? /// G, H, A
  volumePumpedM3         Float?
  estimatedTopMkb        Float?
  estimatedBtmMkb        Float?
  /// Yield in LITRES per sack — the sample prints ft³/sack.
  ///
  /// Litres, not m³: a class G slurry yields about 0.033 m³/sack, and this
  /// suite prints measurements to two decimals, so m³ would have printed that
  /// as "0.03" — a 10% error on a figure a cement volume is calculated from.
  yieldLPerSack          Float?
  /// Mix water in litres per sack — the sample prints gal/sack.
  mixWaterLPerSack       Float?
  freeWaterPct           Float?
  densityPpg             Float?
  plasticViscosityCp     Float?
  thickeningTimeHr       Float?
  compressiveStrengthPsi Float?

  cementStage CementStage           @relation(fields: [cementStageId], references: [id], onDelete: Cascade)
  additives   CementFluidAdditive[]

  @@index([cementStageId, order])
}

/// An additive in a cement fluid — report 04's last block.
model CementFluidAdditive {
  id            String  @id @default(cuid())
  cementFluidId String
  order         Int     @default(0)
  additive      String? /// "Kwik Seal"
  additiveType  String? /// "Lost Circulation Additive", "Retarder", "Accelerator"
  concentration String? /// free text: the sheet prints "0.25 %BWOC", "2 lb/sk"

  cementFluid CementFluid @relation(fields: [cementFluidId], references: [id], onDelete: Cascade)

  @@index([cementFluidId, order])
}
