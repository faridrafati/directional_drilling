# Old Delphi compiled artifacts (kept as reference but not committed)
old_delphi_code/**/*.dcu
old_delphi_code/**/*.exe
old_delphi_code/**/*.identcache
old_delphi_code/**/*.local
old_delphi_code/**/*.ldb
old_delphi_code/Temp.txt
# The Delphi app writes both Temp.mdb (lowercase) and Temp.MDB (uppercase)
# depending on how it was last opened. Match both spellings so the runtime
# artifact never sneaks into a commit on case-sensitive filesystems.
old_delphi_code/Temp.mdb
old_delphi_code/Temp.MDB

# Scratch files at repo root
1.txt
screenshot.png
*.bmp
Directional Drilling.pdf

# Legacy EIV Delphi project — porting reference only, never committed
# (contains compiled binaries + large .las/.txt sample data)
old_eiv_code/

# Old Air & Gas Delphi project — Pascal source kept as reference, but its
# compiled artifacts and sample MDBs are not committed (same policy as
# old_delphi_code/ above).
old_air_mud_code/**/*.dcu
old_air_mud_code/**/*.exe
old_air_mud_code/**/*.dll
old_air_mud_code/**/*.DLL
old_air_mud_code/**/*.identcache
old_air_mud_code/**/*.local
old_air_mud_code/**/*.ldb
old_air_mud_code/**/*.res
old_air_mud_code/**/*.mdb
old_air_mud_code/**/*.MDB
old_air_mud_code/**/*.ico

# Old FMI/EMI Delphi project — Pascal source kept as reference, but its
